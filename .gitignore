# Dados gerados em execução
/storage/*
!/storage/orcamentos/
!/storage/orcamentos/.gitkeep

# Armazenamento local do modulo de orcamentos
/orcamentos/storage/*
!/orcamentos/storage/.gitkeep
/backup/*
!/backup/.gitkeep

# Segredos e ambiente local
.env
.env.*
!.env.example

# Temporários
*.zip
*.bak
*.log
*.tmp
__pycache__/
*.pyc
*.pyo

# IDE
.vscode/
.idea/


# Mantém o bloqueio HTTP da área privada onde ficam os documentos de fotos.
# Os DOCX/PDF gerados e pastas por sessão nunca devem entrar no Git.
/storage/fotos_word/*
!/storage/fotos_word/.htaccess
